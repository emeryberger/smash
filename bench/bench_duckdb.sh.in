#!/usr/bin/env bash
# bench_duckdb.sh - DuckDB OLAP A/B comparison: system malloc vs Smash
#
# DuckDB on macOS uses system malloc (jemalloc extension is Linux-only).
# Analytical queries touch a fraction of columnar data — untouched column
# chunks go cold and get compressed by Smash.
#
# Uses a FIFO to feed SQL to a long-running `duckdb :memory:` process,
# with COPY TO for phase synchronization. Parent shell monitors RSS
# between phases.
#
# Requires duckdb CLI in PATH. Skips gracefully if absent.
#
# Usage:
#   bash bench_duckdb.sh [--quick]
#
# Compatible with bash 3.2+ (macOS default).

set -euo pipefail

# ── Paths (substituted by CMake configure_file) ─────────────────────────────
BUILD_DIR="@CMAKE_BINARY_DIR@"
SMASH_LIB="${BUILD_DIR}/libsmash.dylib"

# ── Platform detection ───────────────────────────────────────────────────────
if [[ "$(uname)" == "Darwin" ]]; then
    PRELOAD_VAR="DYLD_INSERT_LIBRARIES"
else
    PRELOAD_VAR="LD_PRELOAD"
    SMASH_LIB="${BUILD_DIR}/libsmash.so"
fi

# ── Parse flags ──────────────────────────────────────────────────────────────
TPCH_SF=0.5
COOL_DURATION=10
SERVE_ITERATIONS=10

for arg in "$@"; do
    case "$arg" in
        --quick)
            TPCH_SF=0.1
            COOL_DURATION=5
            SERVE_ITERATIONS=5
            ;;
        *) echo "Unknown flag: $arg"; exit 1 ;;
    esac
done

# ── Check prerequisites ─────────────────────────────────────────────────────
if ! command -v duckdb &>/dev/null; then
    echo "SKIP: duckdb not found in PATH (brew install duckdb)"
    exit 0
fi

if [[ ! -f "${SMASH_LIB}" ]]; then
    echo "ERROR: libsmash not found at ${SMASH_LIB}"
    echo "Build with: cmake .. -DSMASH_BUILD_BENCH=ON && make -j"
    exit 1
fi

# ── Temp directory ───────────────────────────────────────────────────────────
TMPDIR_BENCH=$(mktemp -d)
METRIC_FILE="${TMPDIR_BENCH}/metrics.txt"
: > "$METRIC_FILE"

DUCK_PID=""

cleanup() {
    exec 3>&- 2>/dev/null || true
    if [[ -n "$DUCK_PID" ]]; then
        kill "$DUCK_PID" 2>/dev/null || true
        wait "$DUCK_PID" 2>/dev/null || true
    fi
    rm -rf "$TMPDIR_BENCH"
}
trap cleanup EXIT

# ── Helper: get RSS via ps (in KB → MB) ─────────────────────────────────────
get_rss_mb() {
    local pid="$1"
    local rss_kb
    rss_kb=$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ')
    if [[ -n "$rss_kb" && "$rss_kb" -gt 0 ]] 2>/dev/null; then
        echo "scale=1; $rss_kb / 1024" | bc -l
    else
        echo "0"
    fi
}

# ── Helper: emit a metric ───────────────────────────────────────────────────
emit_metric() {
    echo "METRIC $1 $2" >> "$METRIC_FILE"
}

# ── Helper: look up a metric ────────────────────────────────────────────────
metric_val() {
    local name="$1"
    awk -v m="$name" '$1=="METRIC" && $2==m {print $3}' "$METRIC_FILE"
}

# ── Helper: print comparison row ────────────────────────────────────────────
print_row() {
    local label="$1" base_metric="$2" smash_metric="$3" unit="$4"
    local base smash
    base=$(metric_val "$base_metric")
    smash=$(metric_val "$smash_metric")
    base="${base:-N/A}"
    smash="${smash:-N/A}"

    if [[ "$base" == "N/A" || "$smash" == "N/A" || "$base" == "0" ]]; then
        printf "  %-25s %10s%-2s %10s%-2s %10s\n" "$label" "$base" "$unit" "$smash" "$unit" "N/A"
        return
    fi

    local delta
    delta=$(echo "scale=1; (($smash - $base) / $base) * 100" | bc -l 2>/dev/null || echo "N/A")
    if [[ "$delta" != "N/A" ]]; then
        delta="${delta}%"
    fi
    printf "  %-25s %10s%-2s %10s%-2s %10s\n" "$label" "$base" "$unit" "$smash" "$unit" "$delta"
}

# ── Helper: wait for a phase marker file ────────────────────────────────────
wait_for_marker() {
    local marker_file="$1"
    local expected="$2"
    local timeout_sec="${3:-120}"

    local elapsed=0
    while [[ $elapsed -lt $timeout_sec ]]; do
        if [[ -f "$marker_file" ]]; then
            local content
            content=$(cat "$marker_file" 2>/dev/null || true)
            if [[ "$content" == *"$expected"* ]]; then
                return 0
            fi
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    echo "WARNING: Timed out waiting for marker '$expected'"
    return 1
}

# ── Run one DuckDB pass ─────────────────────────────────────────────────────
run_duckdb_pass() {
    local label="$1"
    local use_smash="$2"

    local fifo="${TMPDIR_BENCH}/${label}_fifo"
    local marker="${TMPDIR_BENCH}/${label}_marker"
    local rss_log="${TMPDIR_BENCH}/${label}_rss.log"

    mkfifo "$fifo"
    rm -f "$marker"
    : > "$rss_log"

    echo ""
    echo "[${label}] Starting DuckDB (TPC-H sf=${TPCH_SF})..."

    local t_start
    t_start=$(date +%s)

    # Launch DuckDB reading from FIFO
    if [[ "$use_smash" == "yes" ]]; then
        env "${PRELOAD_VAR}=${SMASH_LIB}" duckdb :memory: < "$fifo" \
            >/dev/null 2>&1 &
    else
        duckdb :memory: < "$fifo" >/dev/null 2>&1 &
    fi
    DUCK_PID=$!

    # Open FIFO for writing (fd 3)
    exec 3> "$fifo"

    # Start background RSS monitor
    # Close fd 3 in subshell so it doesn't keep the FIFO writer alive
    (
        exec 3>&- 2>/dev/null || true
        while kill -0 "$DUCK_PID" 2>/dev/null; do
            get_rss_mb "$DUCK_PID" >> "$rss_log"
            sleep 1
        done
    ) &
    local monitor_pid=$!

    # ── Phase 1: Fill (TPC-H data) ───────────────────────────────────────────
    echo "[${label}] Phase 1: Generate TPC-H data (sf=${TPCH_SF})..."
    rm -f "$marker"
    cat >&3 << SQLEOF
INSTALL tpch;
LOAD tpch;
CALL dbgen(sf=${TPCH_SF});
COPY (SELECT 'fill_done') TO '${marker}' (HEADER false);
SQLEOF

    wait_for_marker "$marker" "fill_done" 120

    local fill_rss
    fill_rss=$(get_rss_mb "$DUCK_PID")
    emit_metric "${label}_fill_rss_mb" "$fill_rss"
    echo "  [${label}] Fill done — RSS: ${fill_rss} MB"

    # ── Phase 2: Cool ────────────────────────────────────────────────────────
    echo "[${label}] Phase 2: Cool for ${COOL_DURATION}s..."
    sleep "$COOL_DURATION"

    local cool_rss
    cool_rss=$(get_rss_mb "$DUCK_PID")
    emit_metric "${label}_cool_rss_mb" "$cool_rss"
    echo "  [${label}] Cool done — RSS: ${cool_rss} MB"

    # ── Phase 3: Hot serve (narrow TPC-H queries) ──────────────────────────
    if kill -0 "$DUCK_PID" 2>/dev/null; then
        echo "[${label}] Phase 3: Serve (${SERVE_ITERATIONS} iterations, narrow date-range queries)..."
        rm -f "$marker"

        # Ignore SIGPIPE in case duckdb dies mid-write
        trap '' PIPE

        local iter=0
        local write_ok=1
        while [[ $iter -lt $SERVE_ITERATIONS && $write_ok -eq 1 ]]; do
            if ! kill -0 "$DUCK_PID" 2>/dev/null; then
                write_ok=0
                break
            fi
            cat >&3 << 'SQLEOF' || write_ok=0
SELECT l_returnflag, l_linestatus, count(*), sum(l_quantity),
       sum(l_extendedprice), sum(l_extendedprice * (1 - l_discount))
FROM lineitem WHERE l_shipdate BETWEEN '1998-11-01' AND '1998-12-01'
GROUP BY l_returnflag, l_linestatus ORDER BY l_returnflag, l_linestatus;
SELECT o_orderpriority, count(*) FROM orders
WHERE o_orderdate >= '1998-07-01' GROUP BY o_orderpriority;
SELECT c_name, sum(o_totalprice) FROM customer
JOIN orders ON c_custkey = o_custkey WHERE o_orderdate >= '1998-01-01'
GROUP BY c_name ORDER BY 2 DESC LIMIT 100;
SQLEOF
            iter=$((iter + 1))
        done

        if [[ $write_ok -eq 1 ]] && kill -0 "$DUCK_PID" 2>/dev/null; then
            cat >&3 << SQLEOF || true
COPY (SELECT 'serve_done') TO '${marker}' (HEADER false);
SQLEOF
            wait_for_marker "$marker" "serve_done" 30 || true

            local serve_rss
            serve_rss=$(get_rss_mb "$DUCK_PID")
            emit_metric "${label}_serve_rss_mb" "$serve_rss"
            echo "  [${label}] Serve done — RSS: ${serve_rss} MB"
        else
            echo "  [${label}] DuckDB exited during serve phase"
        fi

        # Restore default SIGPIPE handling
        trap - PIPE
    fi

    # ── Phase 4: Cold re-access (full-scan TPC-H queries) ───────────────────
    if kill -0 "$DUCK_PID" 2>/dev/null; then
        echo "[${label}] Phase 4: Cold re-access (full-scan + multi-table joins)..."
        rm -f "$marker"

        trap '' PIPE
        cat >&3 << 'SQLEOF' || true
SELECT l_returnflag, l_linestatus, sum(l_quantity), sum(l_extendedprice),
       sum(l_extendedprice * (1-l_discount)),
       sum(l_extendedprice * (1-l_discount) * (1+l_tax)),
       avg(l_quantity), avg(l_extendedprice), avg(l_discount), count(*)
FROM lineitem WHERE l_shipdate <= '1998-12-01'
GROUP BY l_returnflag, l_linestatus ORDER BY l_returnflag, l_linestatus;
SELECT n_name, sum(l_extendedprice * (1 - l_discount)) as revenue
FROM customer, orders, lineitem, supplier, nation, region
WHERE c_custkey = o_custkey AND l_orderkey = o_orderkey AND l_suppkey = s_suppkey
  AND c_nationkey = s_nationkey AND s_nationkey = n_nationkey
  AND n_regionkey = r_regionkey AND r_name = 'ASIA'
  AND o_orderdate >= '1994-01-01' AND o_orderdate < '1995-01-01'
GROUP BY n_name ORDER BY revenue DESC;
SELECT c_custkey, c_name, sum(l_extendedprice * (1-l_discount)) as revenue,
       c_acctbal, n_name, c_address, c_phone, c_comment
FROM customer, orders, lineitem, nation
WHERE c_custkey = o_custkey AND l_orderkey = o_orderkey
  AND o_orderdate >= '1993-10-01' AND o_orderdate < '1994-01-01'
  AND l_returnflag = 'R' AND c_nationkey = n_nationkey
GROUP BY c_custkey, c_name, c_acctbal, c_phone, n_name, c_address, c_comment
ORDER BY revenue DESC LIMIT 20;
SQLEOF
        cat >&3 << SQLEOF || true
COPY (SELECT 'cold_done') TO '${marker}' (HEADER false);
SQLEOF
        trap - PIPE

        if kill -0 "$DUCK_PID" 2>/dev/null; then
            wait_for_marker "$marker" "cold_done" 60 || true

            local cold_rss
            cold_rss=$(get_rss_mb "$DUCK_PID")
            emit_metric "${label}_cold_rss_mb" "$cold_rss"
            echo "  [${label}] Cold re-access done — RSS: ${cold_rss} MB"
        else
            echo "  [${label}] DuckDB exited during cold re-access phase"
        fi
    fi

    # ── Finish ───────────────────────────────────────────────────────────────
    # Close FIFO → DuckDB gets EOF and exits
    exec 3>&- 2>/dev/null || true
    wait "$DUCK_PID" 2>/dev/null || true
    DUCK_PID=""

    # Stop monitor
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true

    local t_end
    t_end=$(date +%s)
    local total_sec=$((t_end - t_start))

    echo "  [${label}] Total time: ${total_sec}s"
    emit_metric "${label}_total_sec" "$total_sec"

    # Extract peak/min/final from RSS log
    if [[ -s "$rss_log" ]]; then
        awk -v lbl="$label" '
        BEGIN { peak=0; min=999999; last=0; }
        {
            v = $1 + 0;
            if (v > peak) peak = v;
            if (v > 0 && v < min) min = v;
            last = v;
        }
        END {
            printf "METRIC %s_peak_rss_mb %s\n", lbl, peak;
            printf "METRIC %s_min_rss_mb %s\n", lbl, (min == 999999 ? 0 : min);
            printf "METRIC %s_final_rss_mb %s\n", lbl, last;
        }' "$rss_log" >> "$METRIC_FILE"
    fi

    rm -f "$fifo" "$marker"
}

# ── Main ─────────────────────────────────────────────────────────────────────
echo ""
echo "========================================================================"
echo "  DuckDB OLAP A/B Comparison"
echo "========================================================================"
echo ""
echo "TPC-H sf=${TPCH_SF}, Cool: ${COOL_DURATION}s, Iterations: ${SERVE_ITERATIONS}"
echo ""

# Run baseline
run_duckdb_pass "baseline" "no"

# Run Smash
run_duckdb_pass "smash" "yes"

# ── Display results ──────────────────────────────────────────────────────────
echo ""
echo "  ------------------------------------------------------------------------"
printf "  %-25s %12s %12s %10s\n" "Metric" "Baseline" "Smash" "Delta"
echo "  ------------------------------------------------------------------------"

print_row "Peak RSS"           "baseline_peak_rss_mb"    "smash_peak_rss_mb"    "MB"
print_row "Fill RSS"           "baseline_fill_rss_mb"    "smash_fill_rss_mb"    "MB"
print_row "Post-cool RSS"      "baseline_cool_rss_mb"    "smash_cool_rss_mb"    "MB"
print_row "Serve RSS"          "baseline_serve_rss_mb"   "smash_serve_rss_mb"   "MB"
print_row "Min RSS"            "baseline_min_rss_mb"     "smash_min_rss_mb"     "MB"
print_row "Cold re-access RSS" "baseline_cold_rss_mb"    "smash_cold_rss_mb"    "MB"
print_row "Final RSS"          "baseline_final_rss_mb"   "smash_final_rss_mb"   "MB"
print_row "Total time"         "baseline_total_sec"      "smash_total_sec"      "s"

echo ""
echo "Done."
